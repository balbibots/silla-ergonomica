# Copia este archivo a ".env" (sin el ".example") y rellena tus valores
# reales. El archivo ".env" NUNCA se sube a git (mira el .gitignore).

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cada cuantas horas comprueba el precio (bucle interno del contenedor).
CHECK_INTERVAL_HOURS=6

# Cada cuantos dias manda el mensaje de "sigo vivo".
HEARTBEAT_DAYS=7

# "true" avisa de CUALQUIER cambio de precio, no solo de las bajadas de umbral.
NOTIFY_ON_ANY_CHANGE=true

# Reintentos ante un fallo puntual de red antes de avisar de un error.
REINTENTOS=2
ESPERA_ENTRE_REINTENTOS_SEG=5

# Como se lee Amazon: "auto" (navegador real si esta disponible, y si no
# peticiones HTTP), "navegador" o "http". Con "http" Amazon sirve un CAPTCHA
# casi siempre; en Docker se usa el navegador.
AMAZON_MODO=auto

# Segundos de espera antes de reintentar tras un CAPTCHA de Amazon.
ESPERA_CAPTCHA_SEG=60
