# Copia este archivo a ".env" (sin el ".example") y rellena tus valores
# reales. El archivo ".env" NUNCA se sube a git (mira el .gitignore).
#
# Solo secretos y ajustes tecnicos. Productos, canal, intervalos y reglas de
# aviso estan en data/config.json (se crea solo la primera vez a partir de
# config.example.json).

# --- Canal "telegram" (el de siempre)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Canal "discord": webhook de un canal privado
# (Ajustes del canal > Integraciones > Webhooks > Nuevo webhook > Copiar URL)
DISCORD_WEBHOOK_URL=

# --- Lectura de Amazon
# En Docker la imagen fija AMAZON_MODO=navegador (con "http" Amazon sirve un
# CAPTCHA casi siempre). Descomentalo solo para forzar otro modo.
# AMAZON_MODO=navegador
# Segundos maximos esperando a que la ficha termine de pintarse.
AMAZON_ESPERA_PAGINA_SEG=20
# Pausa antes del unico reintento ante un fallo puntual (no ante un bloqueo).
ESPERA_ENTRE_REINTENTOS_SEG=5
